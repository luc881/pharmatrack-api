# =========================================================
# 🗄️ Database
# =========================================================
DATABASE_URL=postgresql://user:password@localhost/db_name

# =========================================================
# 🔐 JWT / Security
# =========================================================
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =========================================================
# 🌍 App
# =========================================================
ENVIRONMENT=development

# =========================================================
# 🌱 Seeds del arranque
# =========================================================
# Otra instalación (otro cliente): false = sin el catálogo de Opuntia Den
# SEED_CATALOG=true
# Admin de una BD vacía; sin contraseña se genera una y sale en el log
# SUPERUSER_EMAIL=admin@pharmatrack.com
# SUPERUSER_PASSWORD=

# =========================================================
# 🔒 CORS (solo necesario en producción)
# =========================================================
# ALLOWED_ORIGINS=["https://tu-frontend.vercel.app","https://tu-dominio.com"]

# =========================================================
# 📋 Logging
# =========================================================
LOG_LEVEL=DEBUG

# Descomenta solo cuando necesites ver las queries de SQLAlchemy
# SQLALCHEMY_LOG_LEVEL=INFO

# =========================================================
# 📦 Guías de envío (Envia.com) — opcional, solo dashboard
# =========================================================
# Token de shipping.envia.com > Developers > API Keys (o shipping-test para pruebas)
# ENVIA_API_TOKEN=
# true = ambiente de pruebas (guías sin valor). El token debe ser del mismo ambiente.
# ENVIA_SANDBOX=true
# Remitente, JSON en una línea. "state" con el nombre del estado o el código de Envia
# ENVIA_ORIGIN={"name":"Mi tienda","phone":"5512345678","street":"Calle","number":"12","district":"Colonia","city":"Ciudad de México","state":"Ciudad de México","postalCode":"07000"}

# =========================================================
# 🚨 Avisos de errores (Sentry) — opcional
# =========================================================
# SENTRY_DSN=

# =========================================================
# 🛒 Tienda: IP real del visitante — opcional
# =========================================================
# El sitio público llama a la API desde su servidor, así que sin esto todos
# los clientes comparten una misma IP. Con el MISMO valor aquí y en el sitio
# (su variable SHOP_PROXY_SECRET), la API cuenta por visitante: límites por
# IP y tope diario de pedidos por red. Cualquier texto largo y al azar.
# SHOP_PROXY_SECRET=
