# Copia este archivo como .env.sync (mismo folder) y pega la URL PUBLICA
# de la BD de Railway: proyecto -> servicio Postgres -> Variables ->
# DATABASE_PUBLIC_URL (la que contiene "proxy.rlwy.net").
PROD_DATABASE_URL=

# Otra instalacion (otro cliente): una linea <NOMBRE>_DATABASE_URL por base.
# backup-prod.ps1 respalda todas; sync-down/sync-up solo usan PROD.
# PATITAS_DATABASE_URL=

# Copia de los respaldos a Cloudflare R2 (opcional). Con las cuatro puestas,
# backup-prod.ps1 sube los .dump al bucket. Necesita rclone instalado.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
